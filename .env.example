# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Clerk (kimlik doğrulama: e-posta, Google, GitHub, GitLab) ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=                 # sadece sunucu
CLERK_WEBHOOK_SIGNING_SECRET=     # sadece sunucu (Clerk Dashboard > Webhooks)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/register

# --- Supabase (Postgres) ---
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SECRET_KEY=              # sadece sunucuda kullanılır, asla NEXT_PUBLIC_ ile başlamaz

# --- Upstash Redis ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Opsiyonel dış kaynaklar (yoksa ilgili kontrol atlanır) ---
ABUSEIPDB_API_KEY=
URLHAUS_AUTH_KEY=
GOOGLE_WEB_RISK_API_KEY=
