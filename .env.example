# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_CONTACT_EMAIL=          # KVKK başvuruları ve destek için gösterilen adres

# --- Clerk (giriş: e-posta, Google, GitHub, GitLab) ---
# Oturumlar Clerk'in açık JWKS anahtarlarıyla sunucuda doğrulanır; secret key gerekmez.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/register

# --- Supabase (Postgres) ---
# Veriler API'ye kapalı cq_private şemasında; sunucu sadece cq_* fonksiyonlarını çağırır.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Sunucuya özel uzun rastgele değer (ör. `openssl rand -base64 48`). SHA-256 hash'i
# cq_private.config tablosuna yazılır (bkz. README). Asla NEXT_PUBLIC_ ile başlamaz.
CYBERQUA_DB_SECRET=

# --- Opsiyonel dış kaynaklar (yoksa ilgili kontrol atlanır) ---
ABUSEIPDB_API_KEY=
URLHAUS_AUTH_KEY=
GOOGLE_WEB_RISK_API_KEY=
